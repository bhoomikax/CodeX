# Server-side only: the Next.js rewrite proxies /api/backend/* to this URL.
# It is never exposed to the browser. Copy this file to .env.local.
BACKEND_API_URL=http://127.0.0.1:8000

# Optional: LAN addresses allowed to use the dev server's hot reload when you
# open the site via http://<your-ip>:3000 instead of localhost.
ALLOWED_DEV_ORIGINS=10.225.243.71
