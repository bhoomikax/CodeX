# Database. For an isolated demo that never touches PostgreSQL, use a SQLite
# file instead, e.g. DATABASE_URL=sqlite:///./codex-demo.sqlite3
DATABASE_URL=postgresql://codex_user:codex_password@localhost:5433/codex

# Judge0 sandbox used for every evaluation. Leave JUDGE0_URL blank to disable
# evaluation (submissions then return HTTP 503 and nothing is saved).
# Self-hosted / CE instances use the X-Auth-Token header; *.rapidapi.com hosts
# automatically use X-RapidAPI-Key. Set JUDGE0_AUTH_HEADER to override.
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_AUTH_HEADER=
JUDGE0_TIMEOUT_SECONDS=15
JUDGE0_EVALUATION_TIMEOUT_SECONDS=35

# Optional OpenAI-compatible chat completions endpoint (server-side only).
# Set AI_API_KEY and AI_API_URL to enable; leave either blank for rule-based
# feedback. Keys must stay in backend/.env and must never use NEXT_PUBLIC_ names.
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=8

# Comma-separated browser origins allowed by CORS.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
